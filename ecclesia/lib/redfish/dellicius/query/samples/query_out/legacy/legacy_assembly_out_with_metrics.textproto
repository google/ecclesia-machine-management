# proto-file: ecclesia/lib/redfish/dellicius/query/query_result.proto
# proto-message: DelliciusQueryResult

query_id: "AssemblyCollectorWithPropertyNameNormalization"
subquery_output_by_id {
  key: "Chassis"
  value {
    data_sets {
      properties {
        name: "serial_number"
        string_value: "000000000000000"
      }
      properties {
        name: "part_number"
        string_value: "0000000-00"
      }
    }
  }
}
redfish_metrics {
  uri_to_metrics_map {
    key: "/redfish/v1"
    value {
