        key: "GET"
        value {
          request_count: 1
        }
      }
    }
  }
  uri_to_metrics_map {
    key: "/redfish/v1/Chassis?$expand=.($levels=1)"
    value {
      request_type_to_metadata {
        key: "GET"
        value {
          request_count: 1
        }
      }
    }
  }
  uri_to_metrics_map {
    key: "/redfish/v1/Systems"
    value {
      request_type_to_metadata {
        key: "GET"
        value {
          request_count: 1
        }
      }
    }
  }
  uri_to_metrics_map {
    key: "/redfish/v1/Systems/system"
    value {
      request_type_to_metadata {
        key: "GET"
        value {
          request_count: 1
        }
      }
    }
  }
  uri_to_metrics_map {
    key: "/redfish/v1/Systems/system/Processors?$expand=~($levels=1)"
    value {
      request_type_to_metadata {
        key: "GET"
        value {
          request_count: 1
        }
      }
    }
  }
}
